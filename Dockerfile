# 1. تحديد بيئة التشغيل (مثلما تختار نسخة الويندوز، نحن نختار نسخة خفيفة من Node.js)
FROM node:18-alpine

# 2. إنشاء مجلد داخل الحاوية ليوضع فيه المشروع
WORKDIR /app

# 3. نسخ ملفات الحزم أولاً (هذه خدعة لتسريع البناء لاحقاً)
COPY package*.json ./

# 4. تثبيت المكتبات (نفس ما تفعله في جهازك)
RUN npm install

# 5. بناء ملفات Prisma لقاعدة البيانات (بما أنني رأيت مجلد prisma في مشروعك)
COPY prisma ./prisma/
RUN npx prisma generate

# 6. نسخ باقي ملفات المشروع إلى داخل الحاوية
COPY . .

# 7. المنفذ الذي سيعمل عليه النظام (لنفترض أنه 3000، يمكنك تغييره حسب مشروعك)
EXPOSE 3000

# 8. أمر التشغيل النهائي للمشروع
CMD ["npm", "run", "dev"]